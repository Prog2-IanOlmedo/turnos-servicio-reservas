RESERVAS_DB_NAME=reservas
RESERVAS_DB_USER=reservas
RESERVAS_DB_PASSWORD=cambiar-esto
RESERVAS_DB_PORT=5434
CATEDRA_API_URL=http://host-de-la-catedra:puerto
CATEDRA_JWT=pegar-aca-el-jwt-tecnico
# Generar con: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=pegar-aca-una-clave-base64-de-64-bytes
# Kafka de la cátedra: copiar los valores de la integración de la cuenta técnica
KAFKA_BOOTSTRAP_SERVERS=host-de-kafka:puerto
KAFKA_CONSUMER_GROUP_ID=alumnos-tu-group-id
CATEDRA_GROUP_ID=tu-group-id
KAFKA_ACTIONS_TOPIC=alumnos.turnos.acciones.tu-group-id
KAFKA_PHONE_TOPIC=catedra.turnos.telefono.tu-group-id
# URL del catálogo. Desde Docker, mientras estén en composes separados, se llega por el host
CATALOGO_API_URL=http://host.docker.internal:8081
